/*
 * twang cm85 — I2S audio output for the EK-RA8D2.
 *
 * SSIE1 (i2s1) feeds the on-board codec's I2S input; the GPT PWM (pwm2)
 * synthesizes the codec MCLK. 3.072 MHz = 48 kHz x 64, matching the engine's
 * kSampleRate (48000).
 *
 * NOTE: the PWM MCLK needs verification on hardware — if the GPT cannot
 * synthesize 3.072 MHz within the SSIE driver's tolerance, the frame rate
 * must be reconciled (re-tune the PWM, or run the engine at 44.1 kHz).
 */

#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/usb/audio.h>

/ {
	aliases {
		i2s-tx = &i2s1;
	};

	chosen {
		zephyr,dtcm = &dtcm;
	};

	// The audio engine's DSP state lives in the Cortex-M85 DTCM (tightly
	// coupled, per-core data memory): fast and off the shared SDRAM. The
	// chosen zephyr,dtcm node turns on the generic linker's .dtcm_bss section.
	dtcm: memory@20000000 {
		compatible = "zephyr,memory-region", "arm,dtcm";
		reg = <0x20000000 DT_SIZE_K(64)>;
		zephyr,memory-region = "DTCM";
	};
};

&pinctrl {
	ssie1_default: ssie1_default {
		group1 {
			/* SSI_BCK SSI_LRCK SSI_DATA */
			psels = <RA_PSEL(RA_PSEL_SSIE, 7, 2)>,
				<RA_PSEL(RA_PSEL_SSIE, 7, 1)>,
				<RA_PSEL(RA_PSEL_SSIE, 7, 0)>;
			drive-strength = "high";
		};
	};

	pwm2_default: pwm2_default {
		group1 {
			/* GTIOC2A */
			psels = <RA_PSEL(RA_PSEL_GPT1, 7, 13)>;
			drive-strength = "medium";
		};
	};
};

&i2s1 {
	pinctrl-0 = <&ssie1_default>;
	pinctrl-names = "default";
	interrupts = <95 1>, <94 1>;
	interrupt-names = "ssi_rt", "ssi_if";
	status = "okay";
	clocks = <&pclkb MSTPC 7>, <&ssi_internal_clock 0>;
	clock-names = "pclk", "audio-clock";
};

&pwm2 {
	pinctrl-0 = <&pwm2_default>;
	pinctrl-names = "default";
	interrupts = <93 1>, <92 1>;
	interrupt-names = "gtioca", "overflow";
	status = "okay";

	ssi_internal_clock: pwmclock {
		status = "okay";
		compatible = "pwm-clock";
		#clock-cells = <1>;
		pwms = <&pwm2 0 PWM_HZ(3072000) PWM_POLARITY_NORMAL>;
	};
};

/* Dual-core IPC: M33 → M85 notification (events pending on the shared ring).
 * The driver links EVENT_IPC_IRQ0 to this vector at runtime, so the number is
 * arbitrary — 29 is free (wired IRQs: 0..28, 92..95). */
&mbox0 {
	status = "okay";
	interrupts = <29 1>;
};

/*
 * Composite USB device on the board's USB-HS UDC (zephyr_udc0): UAC2 audio
 * (source-only instrument → host) + USB MIDI 2.0 (host → instrument).
 */

/ {
	usb_midi: usb_midi {
		compatible = "zephyr,midi2-device";
		status = "okay";
		#address-cells = <1>;
		#size-cells = <1>;
		label = "twang MIDI";

		midi_in_out@0 {
			reg = <0 1>;
			protocol = "midi1-up-to-128b";
			label = "MIDI-IN-OUT";
		};
	};

	uac2_synth: usb_audio2 {
		compatible = "zephyr,uac2";
		status = "okay";
		full-speed;
		high-speed;
		audio-function = <AUDIO_FUNCTION_MUSICAL_INSTRUMENT>;

		uac_aclk: aclk {
			compatible = "zephyr,uac2-clock-source";
			clock-type = "internal-fixed";
			frequency-control = "read-only";
			sampling-frequencies = <48000>;
		};

		/* The engine's audio output: the source entering the function. */
		engine_input: engine_input {
			compatible = "zephyr,uac2-input-terminal";
			clock-source = <&uac_aclk>;
			terminal-type = <INPUT_TERMINAL_UNDEFINED>;
			front-left;
			front-right;
		};

		/* Audio leaves the function to the host (device -> host capture). */
		usb_out: usb_out {
			compatible = "zephyr,uac2-output-terminal";
			data-source = <&engine_input>;
			clock-source = <&uac_aclk>;
			terminal-type = <USB_TERMINAL_STREAMING>;
		};

		/* One async isochronous IN stream; no feedback (source only). */
		as_iso_in: in_interface {
			compatible = "zephyr,uac2-audio-streaming";
			linked-terminal = <&usb_out>;
			subslot-size = <2>;
			bit-resolution = <16>;
		};
	};
};
